# Weed OS — pilotes génériques Wi-Fi/Bluetooth.
# Les pilotes spécifiques à la carte Wi-Fi et au contrôleur Bluetooth
# restent à sélectionner selon le matériel cible.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HIDP=m

# Familles de contrôleurs Wi-Fi courantes (firmwares parfois requis séparément).
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_RTL8XXXU=m
CONFIG_RTW88=m
CONFIG_BRCMFMAC=m
CONFIG_MT76=m
CONFIG_MT7921E=m
# Profils et partage Bluetooth usuels.
CONFIG_BT_RFCOMM=m
CONFIG_BT_BNEP=m

# Audio Linux natif (ALSA). Pilotes compilés dans le noyau (=y) : aucun udev/modprobe
# n'est lancé au boot, des pilotes en module (=m) ne seraient jamais chargés -> pas de son.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_TIMER=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
CONFIG_SND_HDA_CODEC_VIA=y
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_HDA_CODEC_CIRRUS=y
CONFIG_SND_HDA_CODEC_CMEDIA=y
CONFIG_SND_INTEL8X0=y
CONFIG_SND_USB=y
CONFIG_SND_USB_AUDIO=y
CONFIG_SND_VIRTIO=y
