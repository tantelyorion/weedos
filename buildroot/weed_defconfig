# Weed OS - défaut Buildroot (x86_64, ISO bootable BIOS). POINT DE DÉPART : à valider avec `make menuconfig`.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# NetworkManager configure Ethernet et Wi-Fi au lieu du DHCP fixe eth0.
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="weed"
BR2_TARGET_GENERIC_ISSUE="Weed OS"
BR2_INIT_NONE=y
# /dev géré par eudev : libinput, NetworkManager et cage en dépendent (sans cela Buildroot les ignore silencieusement).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_POST_BUILD_SCRIPT="board/weed/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="board/weed/post-fakeroot.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/weed/kernel.fragment"
BR2_LINUX_KERNEL_BZIMAGE=y
# PHP : le "moteur" de Weed OS
BR2_PACKAGE_PHP=y
BR2_PACKAGE_PHP_SAPI_CLI=y
BR2_PACKAGE_PHP_EXT_ZIP=y
BR2_PACKAGE_PHP_EXT_PCNTL=y
BR2_PACKAGE_PHP_EXT_POSIX=y
BR2_PACKAGE_PHP_EXT_OPENSSL=y
BR2_PACKAGE_PHP_EXT_PHAR=y
BR2_PACKAGE_PHP_EXT_MBSTRING=y
BR2_PACKAGE_PHP_EXT_SQLITE=y
# Audio natif : décodage MP3 par mpg123 et sortie ALSA (son de bienvenue du système).
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_MPG123=y
# alsa-utils : amixer dé-mute la carte son (ALSA démarre muet) avant le son de bienvenue.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y

# Médias : FFmpeg fourni par le système aux Programmes (service Kernel media.*, voir docs/MEDIA-FFMPEG.md).
# Version GPL (choix du projet) : active x264/x265 (H.264/H.265). Le FFmpeg de l'ISO est donc sous GPL : publier les sources de l'ISO.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_X264=y
BR2_PACKAGE_X265=y
BR2_PACKAGE_LIBVPX=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_LAME=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_WEBP=y

# Affichage : Mesa (rendu logiciel) + cage (compositeur Wayland kiosque) + cog (WebKit)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_EUDEV=y
# Réseau : NetworkManager + nmcli, avec wpa_supplicant pour le Wi-Fi.
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# Bluetooth : BlueZ et son client bluetoothctl.
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_WPEWEBKIT=y
BR2_PACKAGE_COG=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_XKEYBOARD_CONFIG=y
BR2_PACKAGE_DEJAVU=y
# Outils pour l'installateur (weed-install.php)
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_E2FSPROGS=y
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="board/weed/grub.cfg"
# ISO bootable GRUB2 avec initramfs (mode live modifiable)
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux normal configfile search search_label iso9660 ext2 part_msdos part_gpt biosdisk"
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
